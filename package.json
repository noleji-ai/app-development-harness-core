{
  "name": "app-development-harness",
  "version": "1.2.0",
  "description": "Decision-led, resumable app development harness for Codex",
  "type": "module",
  "bin": {
    "app-harness": "./dist/cli.js"
  },
  "files": [
    ".codex-plugin/",
    "assets/dashboard/",
    "dist/",
    "registry/",
    "skills/",
    "ADAPTERS.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.txt",
    "docs/",
    "PROVENANCE.md",
    "README.md",
    "hooks.json"
  ],
  "scripts": {
    "build": "bun build src/cli.ts src/internal-audit-worker.ts src/surface-qa-worker.ts --target node --outdir dist",
    "typecheck": "tsc --noEmit",
    "check": "bunx biome check . && bunx tsc --noEmit",
    "test": "bun test ./tests/ --timeout 20000",
    "test:e2e": "bun test ./tests/e2e --timeout 20000"
  },
  "dependencies": {
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/bun": "1.3.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noleji-ai/app-development-harness-core.git"
  },
  "bugs": {
    "url": "https://github.com/noleji-ai/app-development-harness-core/issues"
  },
  "homepage": "https://github.com/noleji-ai/app-development-harness-core#readme"
}
